<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Screen capture as a scene source. Add the type to the service only AFTER
         user consent: on Android 14+, starting a service with type
         mediaProjection without granted permission is forbidden. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Lint checks FGS-type permissions per module; app module declares these too (merged). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application>
        <service
            android:name=".StreamService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone|mediaProjection" />
    </application>

</manifest>