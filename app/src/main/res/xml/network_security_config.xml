<?xml version="1.0" encoding="utf-8"?>
<!-- Unencrypted HTTP is allowed. Test bench 04.10 found WHIP over http://
     (MediaMTX default, a private home-network server) failed immediately:
     Android API 28+ disallows cleartext. The owner chose to allow it (04.10):
     our RTMP already sends the stream key without encryption, and the server
     editor warns about WHIP http:// URLs. Requests to external services
     (Twitch, Kick, donations, emotes) use https themselves. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
