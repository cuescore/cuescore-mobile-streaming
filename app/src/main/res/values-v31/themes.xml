<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws the splash screen itself, before our code, and gets the color from here.
         Without this, it used the light theme’s white background — the same white screen at
         startup that the owner saw and wrote about (14.09 and 15.09). -->
    <style name="Theme.Brix" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_cuescore_logo</item>
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
</resources>
