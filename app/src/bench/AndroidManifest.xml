<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Copy of app/src/debug/AndroidManifest.xml: the bench sends live-stream
             commands (START/STOP/RECONNECT/MUTE) directly to the service, which is
             exposed externally only in debug builds. Keep the type list in sync with
             streaming/src/main/AndroidManifest.xml — tools:node="replace" replaces
             the entire declaration (see the comment in debug). -->
        <service
            android:name="app.brix.streaming.StreamService"
            android:exported="true"
            android:foregroundServiceType="camera|microphone|mediaProjection"
            tools:node="replace" />
    </application>
</manifest>
